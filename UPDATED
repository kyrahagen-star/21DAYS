function readFor(n){var j=PLAN[0][1].split('\n').map(function(l){return /^\s*(\d+)\s*[–-]\s*(.*)$/.exec(l)}).filter(function(q){return q&&+q[1]===n})[0];return j?j[2].trim():''}
/* ===== END CONTENT ===== */

var MN=['January'],DN=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
var ALL=[];WEEKS.forEach(function(w,i){w.days.forEach(function(d){ALL.push({n:d[0],q:d[1],r:d[2],p:d[3],w:i})})});
var FIRST=ALL[0].n,LAST=ALL[ALL.length-1].n;
function readBox(n){var r=readFor(n);return r?'<div class="read"><div class="eyebrow">Bible reading · Jan '+n+'</div><div class="b rd">'+r+'</div></div>':''}
function dayName(n){return DN[new Date(YEAR,MONTH,n).getDay()]}
function pick(){
  var m=/^#jan-(\d+)$/.exec(location.hash);
  var pv=/^#preview-jan-(\d+)$/.exec(location.hash);if(pv){var p=+pv[1];if(p>=FIRST&&p<=LAST)return{n:p,mode:'today'}}
  if(m){var h=+m[1];if(h>=FIRST&&h<=LAST)return{n:h,mode:'pick'}}
  var t=new Date(),y=t.getFullYear(),mo=t.getMonth(),d=t.getDate();
  if(y===YEAR&&mo===MONTH&&d>=FIRST&&d<=LAST)return{n:d,mode:'today'};
  if(y<YEAR||(y===YEAR&&mo<MONTH)||(y===YEAR&&mo===MONTH&&d<FIRST))return{n:FIRST,mode:'before'};
  return{n:LAST,mode:'after'};
}
function render(){
  var s=pick(),i=ALL.findIndex(function(x){return x.n===s.n}),x=ALL[i],w=WEEKS[x.w],note='';
  if(s.mode==='before')note='Our time of prayer &amp; fasting begins '+dayName(FIRST)+', January '+FIRST+'. Here’s a preview of Day 1.';
  if(s.mode==='after')note='This season of prayer &amp; fasting has wrapped up. Revisit any day in the plan below.';
  if(s.mode==='pick')note='You’re viewing a different day. <a href="#" id="back" style="color:inherit;font-weight:700">Back to today</a>';
  document.getElementById('today').innerHTML=
   '<div class="eyebrow">Week '+(x.w+1)+' · '+w.title+'</div>'+
   '<h1>Day '+(i+1)+'<br>'+dayName(x.n)+', Jan '+x.n+'</h1>'+
   '<p class="tag">'+w.tag+'</p>'+(note?'<div class="banner">'+note+'</div>':'')+
   '<blockquote>“'+x.q+'”</blockquote><div class="ref">'+x.r+'</div>'+
   '<p class="prompt">'+x.p+'</p>'+readBox(x.n)+
   '<div class="nav"><button id="prev"'+(i===0?' disabled':'')+'>← Previous</button><button id="next" class="solid"'+(i===ALL.length-1?' disabled':'')+'>Next day →</button></div>';
  document.getElementById('prev').onclick=function(){go(ALL[i-1].n)};
  document.getElementById('next').onclick=function(){go(ALL[i+1].n)};
  var b=document.getElementById('back');if(b)b.onclick=function(e){e.preventDefault();history.replaceState(null,'',location.pathname+location.search);render();window.scrollTo(0,0)};
  var h='';
  WEEKS.forEach(function(wk,wi){
    h+='<div class="wk"><div class="eyebrow">Week '+(wi+1)+'</div><h3>'+wk.title+'</h3><p class="intro">'+wk.intro+'</p>';
    ALL.filter(function(d){return d.w===wi}).forEach(function(d){
      h+='<button class="day'+(d.n===s.n?' on':'')+'" data-n="'+d.n+'"><span class="d">'+dayName(d.n)+', Jan '+d.n+(d.n===s.n?' · Viewing':'')+'</span><span class="q">“'+d.q+'”</span> <span class="r">'+d.r+'</span><span class="p">'+d.p+'</span></button>';
    });
    h+='</div>';
  });
  var c=document.getElementById('weeks');c.innerHTML=h;
  c.querySelectorAll('.day').forEach(function(el){el.onclick=function(){go(+el.dataset.n)}});
  var mo=document.getElementById('months');
  if(!mo.innerHTML){mo.innerHTML=PLAN.map(function(m,mi){return '<details'+(mi===0?' open':'')+'><summary>'+m[0]+'</summary><ul class="ym">'+m[1].trim().split('\n').map(function(l){var q=/^\s*(\d+)\s*[–-]\s*(.*)$/.exec(l);return q?'<li data-m="'+mi+'" data-d="'+q[1]+'"><b>'+q[1]+'</b><span>'+q[2].trim()+'</span></li>':''}).join('')+'</ul></details>'}).join('')}
  mo.querySelectorAll('li').forEach(function(li){li.classList.toggle('on',li.dataset.m==='0'&&+li.dataset.d===s.n)});
}
function go(n){location.hash='jan-'+n;window.scrollTo(0,0)}
window.addEventListener('hashchange',render);
render();
</script>
